{
  "sourceLanguage": "en",
  "strings": {
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save launch images to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将应用启动图保存到相册。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將 App 啟動畫面儲存至「照片」。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將 App 啟動畫面儲存至「相片」。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh khởi động ứng dụng vào thư viện ảnh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение изображений запуска в вашу медиатеку."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره تصاویر آغاز برنامه در کتابخانه عکس شما."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 시작 이미지를 사진 보관함에 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar imágenes de inicio en tu fototeca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの起動画面を写真ライブラリに保存します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
