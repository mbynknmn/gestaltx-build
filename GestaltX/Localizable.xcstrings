    "Show internal storage categories. Experimental on iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show internal storage categories. Experimental on iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示内部存储分类，在 iPad 上属于实验性功能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar categorías de almacenamiento interno. Experimental en iPad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسته‌های فضای ذخیره‌سازی داخلی را نمایش دهید. روی iPad آزمایشی است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部ストレージのカテゴリを表示します。iPadでは実験的機能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 저장 공간의 세부 카테고리를 표시합니다. iPad에서는 실험적인 기능입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать внутренние категории хранилища. Экспериментально на iPad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các loại bộ nhớ nội bộ. Đang thử nghiệm trên iPad."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
