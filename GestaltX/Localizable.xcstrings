    "Read MobileGestalt in Tools, or share this device's plist to GestaltX.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read MobileGestalt in Tools, or share this device's plist to GestaltX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具中读取 MobileGestalt，或将本机 plist 分享到 GestaltX。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee MobileGestalt en Herramientas o comparte el plist de este dispositivo con GestaltX."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt را در ابزارها بخوانید یا plist همین دستگاه را با GestaltX به اشتراک بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールでMobileGestaltを読み取るか、このデバイスのplistをGestaltXに共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 탭에서 기기의 MobileGestalt를 직접 읽어 들이거나, 파일 앱에서 이 기기의 plist 파일을 찾아 GestaltX로 공유하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считайте MobileGestalt в разделе инструментов или отправьте plist этого устройства в GestaltX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc MobileGestalt trong Công cụ hoặc chia sẻ plist của thiết bị này đến GestaltX."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具中讀取 MobileGestalt，或將本機 plist 分享到 GestaltX。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具中讀取 MobileGestalt，或將本機 plist 分享至 GestaltX。"
          }
        }
      }
    },
    "This plist has been verified for this device. Import it?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plist has been verified for this device. Import it?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核验此 plist 属于本机，是否导入？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plist ha sido verificado para este dispositivo. ¿Deseas importarlo?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این plist برای همین دستگاه تأیید شده است. فایل وارد شود؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このplistはこのデバイス用に検証済みです。読み込みますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 plist 파일은 현재 기기용으로 무결성이 검증되었습니다. 파일 편집을 위해 가져오시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот plist проверен для данного устройства. Импортировать?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plist đã được xác minh cho thiết bị này. Nhập tệp?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已核驗此 plist 屬於本機，是否匯入？"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已核驗此 plist 屬於本機，是否匯入？"
          }
        }
      }
    },
    "This plist's device proof could not be verified on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plist's device proof could not be verified on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在本机验证此 plist 的设备凭证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba de dispositivo de este plist no se pudo verificar en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گواه دستگاه این plist در دستگاه فعلی قابل تأیید نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このplistのデバイス証明を、このデバイス上で検証できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 plist 파일 내의 기기 고유 증명 데이터를 현재 기기에서 정상적으로 검증할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подтверждение принадлежности plist этому устройству."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh bằng chứng thiết bị của plist này trên thiết bị hiện tại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在本機驗證此 plist 的裝置憑證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在本機驗證此 plist 的裝置憑證。"
          }
        }
      }
    },
    "The device proof is temporarily unavailable. Unlock this device and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device proof is temporarily unavailable. Unlock this device and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备凭证暂时不可用。请解锁此设备后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba de pertenencia al dispositivo no está disponible temporalmente. Desbloquea este dispositivo e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گواه دستگاه موقتاً در دسترس نیست. قفل این دستگاه را باز کنید و دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス証明を一時的に利用できません。デバイスのロックを解除して、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 증명을 일시적으로 사용할 수 없습니다. 이 기기의 잠금을 해제한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение устройства временно недоступно. Разблокируйте устройство и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng chứng thiết bị tạm thời không khả dụng. Hãy mở khóa thiết bị này rồi thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置憑證暫時無法使用。請解鎖此裝置後重試。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置憑證暫時無法使用。請解鎖此裝置後重試。"
          }
        }
      }
    },
    "This plist uses a different system cache layout and cannot be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plist uses a different system cache layout and cannot be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 plist 的系统缓存布局与本机不符，无法恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plist usa una estructura de caché del sistema diferente y no se puede restaurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساختار حافظهٔ نهان سیستم این plist با دستگاه فعلی متفاوت است و قابل بازیابی نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このplistは異なるシステムキャッシュレイアウトを使用しているため、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 plist 파일은 현재 기기 시스템과 다른 방식의 캐시 레이아웃 구조를 사용하므로 안전하게 복원할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Структура системного кэша plist отличается от текущей. Восстановление невозможно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục bộ nhớ đệm hệ thống của plist không khớp thiết bị này nên không thể khôi phục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 plist 的系統快取配置與本機不符，無法還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 plist 的系統快取配置與本機不符，無法回復。"
          }
        }
      }
    },
    "Restore Imported Plist": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Imported Plist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复导入的 plist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar plist importado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی plist واردشده"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだplistを復元"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 plist 복원"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить импортированный plist"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục plist đã nhập"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "還原匯入的 plist"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "回復匯入的 plist"
          }
        }
      }
    },
    "The current device file will be backed up before restoring. Restart the device afterward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current device file will be backed up before restoring. Restart the device afterward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前会备份当前设备文件，完成后请重启设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creará un respaldo del archivo actual del dispositivo antes de restaurar. Reinicia el dispositivo después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از بازیابی، از فایل فعلی دستگاه نسخهٔ پشتیبان تهیه می‌شود. پس از پایان، دستگاه را راه‌اندازی مجدد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元前に現在のデバイスファイルをバックアップします。復元後にデバイスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원을 시작하기 전 만약을 대비해 현재 기기 파일이 백업됩니다. 복원이 완료되면 반드시 기기를 재시동하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед восстановлением будет создана резервная копия текущего файла устройства. Затем перезагрузите устройство."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp hiện tại trên thiết bị sẽ được sao lưu trước khi khôi phục. Sau đó hãy khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "還原前會備份目前的裝置檔案，完成後請重新啟動裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "回復前會備份目前的裝置檔案，完成後請重新啟動裝置。"
          }
        }
      }
    },
    "Share this device's plist to GestaltX to edit its keys and values or restore a verified backup. Export a copy from GestaltX first to keep a device-bound proof.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this device's plist to GestaltX to edit its keys and values or restore a verified backup. Export a copy from GestaltX first to keep a device-bound proof."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在可将本机 plist 分享到 GestaltX，核验后导入、增删改键值并恢复。建议先从 GestaltX 导出一份带本机校验凭证的备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte el plist de este dispositivo con GestaltX para editar sus claves y valores o restaurar un respaldo verificado. Exporta una copia desde GestaltX primero para conservar una prueba vinculada al dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "plist همین دستگاه را با GestaltX به اشتراک بگذارید تا پس از تأیید، کلیدها و مقدارها را اضافه، ویرایش یا حذف کنید یا نسخهٔ پشتیبان را بازیابی کنید. بهتر است ابتدا یک نسخه با گواه مخصوص دستگاه از GestaltX صادر کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのplistをGestaltXに共有すると、キーと値を編集したり、検証済みバックアップを復元したりできます。デバイス固有の証明を保持するため、先にGestaltXからコピーを書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 plist를 GestaltX 앱에 공유하면 내부 키와 값을 편집하거나, 이전에 검증해 둔 백업 파일을 시스템에 복원할 수 있습니다. 기기 고유 증명을 안전하게 유지하려면 편집 전 먼저 GestaltX에서 원본 사본을 내보내 두는 것이 좋습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте plist этого устройства в GestaltX для проверки, импорта, добавления, изменения и удаления ключей и восстановления копии. Сначала рекомендуется экспортировать копию из GestaltX с подтверждением для этого устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ plist của thiết bị này đến GestaltX để nhập sau khi xác minh, thêm, sửa, xóa khóa và giá trị hoặc khôi phục bản sao lưu. Trước tiên nên xuất bản sao từ GestaltX kèm bằng chứng gắn với thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "現在可將本機 plist 分享到 GestaltX，核驗後匯入、新增、刪除或修改鍵值並還原。建議先從 GestaltX 匯出一份附有本機驗證憑證的備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "現在可將本機 plist 分享至 GestaltX，核驗後匯入、新增、刪除或修改鍵值並回復。建議先從 GestaltX 匯出一份附有本機驗證憑證的備份。"
          }
        }
      }
    },
