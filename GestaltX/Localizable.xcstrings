    "Connect or open a plist to start editing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect or open a plist to start editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设备或打开 plist，开始编辑。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta o abre un plist para comenzar a editar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای آغاز ویرایش، متصل شوید یا یک فایل plist باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集を始めるには、接続するかplistを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집을 시작하려면 기기에 연결하거나 plist를 여십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к устройству или откройте plist для редактирования."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối hoặc mở tệp plist để bắt đầu chỉnh sửa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連接設備或打開 plist，開始編輯。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連線裝置或開啟 plist，開始編輯。"
          }
        }
      }
    },
