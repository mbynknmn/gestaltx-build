    "This only deletes the imported pack from GestaltX. Applied wallpapers will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only deletes the imported pack from GestaltX. Applied wallpapers will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只从 GestaltX 删除导入包，已应用的壁纸会保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminará el paquete importado de GestaltX. Los fondos aplicados se conservarán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط بستهٔ واردشده از GestaltX حذف می‌شود. تصاویر زمینهٔ اعمال‌شده باقی می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltXから読み込んだパックのみ削除します。適用済みの壁紙は保持されます。"
          }
