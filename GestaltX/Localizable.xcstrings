    "Changes verified on device. Respring to refresh supported features.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes verified on device. Respring to refresh supported features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机更改已验证，可执行注销以刷新受支持的功能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios verificados en el dispositivo. Haz respring para actualizar las funciones compatibles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات روی دستگاه تأیید شدند. برای تازه‌سازی قابلیت‌های پشتیبانی‌شده ری‌اسپرینگ کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上で変更を検証しました。対応機能を更新するにはRespringしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 변경 사항이 검증되었습니다. 새로 지원되는 기능을 시스템에 반영하려면 리스프링을 실행하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения на устройстве проверены. Выполните респринг для обновления поддерживаемых функций."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi trên thiết bị đã được xác minh. Respring để làm mới các tính năng được hỗ trợ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本機更改已驗證，可執行註銷以刷新受支持的功能。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本機更改已驗證，可執行登出以重新整理受支援的功能。"
          }
        }
      }
    },
    "Local changes saved. Export the plist to keep a copy.": {
