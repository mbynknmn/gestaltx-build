    "Keep a copy. Refresh when ready.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a copy. Refresh when ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先留一份备份，准备好后再刷新。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva una copia. Actualiza cuando estés listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کپی نگه دارید و هر وقت آماده بودید بازخوانی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーを保管し、準備ができたら更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본을 보관하십시오. 준비되면 새로고침하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните копию. Обновите данные, когда будете готовы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một bản sao. Làm mới khi sẵn sàng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先留一份備份，準備好後再刷新。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "先留一份備份，準備好後再重新整理。"
          }
        }
      }
    },
