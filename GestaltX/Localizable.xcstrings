    "Experimental settings. Back up before applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental settings. Back up before applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性设置，请在应用前备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes experimentales. Haz un respaldo antes de aplicar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات آزمایشی است. پیش از اعمال، نسخهٔ پشتیبان بگیرید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的な設定です。適用前にバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 설정입니다. 적용하기 전에 백업하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментальные настройки. Перед применением создайте резервную копию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt thử nghiệm. Hãy sao lưu trước khi áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗性設定，請在應用前備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗性設定，請在應用前備份。"
          }
        }
      }
    },
