    "Disabling may show Wi-Fi and change some network options. Restart to apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabling may show Wi-Fi and change some network options. Restart to apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后可显示为 Wi-Fi，部分联网选项可能随之变化。重启后生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarlo, puede mostrarse Wi-Fi y cambiar algunas opciones de red. Reinicia el dispositivo para aplicar los cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با غیرفعال کردن، ممکن است نام Wi-Fi نمایش داده شود و برخی گزینه‌های شبکه تغییر کنند. برای اعمال، دستگاه را راه‌اندازی مجدد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効にするとWi-Fi表記や一部の通信設定が変わる場合があります。反映するには再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비활성화하면 Wi-Fi로 표시되고 일부 네트워크 옵션이 변경될 수 있습니다. 적용하려면 기기를 재시동하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение может изменить название на Wi-Fi и повлиять на некоторые параметры сети. Для применения перезагрузите устройство."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt có thể đổi tên hiển thị thành Wi-Fi và thay đổi một số tùy chọn mạng. Khởi động lại để áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後可顯示為 Wi-Fi，部分連線選項可能隨之變更。重新啟動後生效。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後可顯示為 Wi-Fi，部分連網選項可能隨之變更。重新啟動後生效。"
          }
        }
      }
    },
