          }
        }
      }
    },
    "This device's identity could not be verified. Read MobileGestalt on this device and try sharing again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's identity could not be verified. Read MobileGestalt on this device and try sharing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核验本机身份，请先读取本机 MobileGestalt 后重新分享。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la identidad de este dispositivo. Lee MobileGestalt en este dispositivo e intenta compartir de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هویت این دستگاه تأیید نشد. ابتدا MobileGestalt را روی همین دستگاه بخوانید و دوباره فایل را به اشتراک بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのIDを検証できませんでした。このデバイスでMobileGestaltを読み取り、もう一度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 식별 정보를 교차 검증할 수 없습니다. 이 기기에서 먼저 MobileGestalt를 성공적으로 읽어들인 다음 다시 공유를 시도해 보십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить идентификаторы устройства. Считайте MobileGestalt на этом устройстве и отправьте файл повторно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh danh tính thiết bị này. Đọc MobileGestalt trên thiết bị này rồi chia sẻ lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法核驗本機身份，請先讀取本機 MobileGestalt 後重新分享。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法核驗本機身分，請先讀取本機 MobileGestalt 後重新分享。"
          }
        }
      }
    },
    "This plist belongs to another device and cannot be imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plist belongs to another device and cannot be imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 plist 的设备标识与本机不符，无法导入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plist pertenece a otro dispositivo y no se puede importar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شناسه‌های این plist با دستگاه فعلی مطابقت ندارند و فایل قابل وارد کردن نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このplistは別のデバイスのもので、読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 plist 파일의 식별자가 현재 기기와 일치하지 않아 가져올 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификаторы в plist не совпадают с этим устройством. Импорт невозможен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã định danh trong plist không khớp thiết bị này nên không thể nhập."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
