        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسته تصویر زمینه با قالب .tendies یا .zip را وارد کنید یا آن را با GestaltX به اشتراک بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".tendiesまたは.zipの壁紙パックをインポートします。共有メニューからGestaltXに送ることもできます。"
