    "A different layout can affect the status bar and keyboard. Keep a backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different layout can affect the status bar and keyboard. Keep a backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改布局可能影响状态栏与键盘，请保留备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diseño diferente puede afectar la barra de estado y el teclado. Conserva un respaldo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیدمان متفاوت ممکن است روی نوار وضعیت و صفحه‌کلید اثر بگذارد. نسخهٔ پشتیبان نگه دارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のレイアウトにするとステータスバーやキーボードに影響する可能性があります。バックアップを保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 변경하면 상태 막대 및 키보드 배치에 영향을 줄 수 있습니다. 백업을 보관하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой макет может повлиять на строку состояния и клавиатуру. Сохраните резервную копию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục khác có thể ảnh hưởng đến thanh trạng thái và bàn phím. Hãy giữ bản sao lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改佈局可能影響狀態欄與鍵盤，請保留備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改佈局可能影響狀態列與鍵盤，請保留備份。"
          }
        }
      }
    },
