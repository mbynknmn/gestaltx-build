    "Original values are saved before writing. Revert removes keys that were originally absent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original values are saved before writing. Revert removes keys that were originally absent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入前会保存原值，原本不存在的键会在还原时移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores originales se guardan antes de escribir. Al restaurar se eliminan las claves que no existían."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقادیر اصلی پیش از نوشتن ذخیره می‌شوند. بازگردانی، کلیدهایی را که از ابتدا وجود نداشتند حذف می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み前に元の値を保存します。元に戻すと、追加されたキーは削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 전에 원래 값을 저장합니다. 원래 없던 키는 복원 시 제거됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные значения сохраняются перед записью. При восстановлении ранее отсутствовавшие ключи удаляются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị gốc được lưu trước khi ghi. Khôi phục sẽ xóa các khóa vốn không tồn tại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會儲存原值，原本不存在的鍵會在還原時移除。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會儲存原值，原本不存在的鍵會在還原時移除。"
          }
        }
      }
    },
    "The affected settings files will be backed up before writing. You can restore each option afterward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The affected settings files will be backed up before writing. You can restore each option afterward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入前会备份相关设置文件，之后可逐项还原。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hará una copia de los archivos de ajustes antes de escribir. Después podrás restaurar cada opción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از نوشتن، از فایل‌های تنظیمات مربوط پشتیبان گرفته می‌شود. پس از آن می‌توانید هر گزینه را جداگانه بازگردانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更対象の設定ファイルは書き込み前にバックアップされます。各項目は後から元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 전에 관련 설정 파일을 백업합니다. 이후 각 옵션을 개별적으로 복원할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед записью будет создана резервная копия затронутых файлов настроек. Затем можно восстановить каждый параметр отдельно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp cài đặt liên quan sẽ được sao lưu trước khi ghi. Bạn có thể khôi phục từng tùy chọn sau đó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會備份相關設定檔案，之後可逐項還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會備份相關設定檔案，之後可逐項還原。"
          }
        }
      }
    },
    "The system settings file is not a valid dictionary.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system settings file is not a valid dictionary."
