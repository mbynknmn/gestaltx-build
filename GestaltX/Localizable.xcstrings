    "This OS build may not support the technique. You can close this screen and try a manual restart later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This OS build may not support the technique. You can close this screen and try a manual restart later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前系统版本可能不支持此方法。你可以关闭此页面，稍后手动重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación del SO puede no admitir esta técnica. Puedes cerrar esta pantalla e intentar un reinicio manual más tarde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است این نسخهٔ سیستم‌عامل از این روش پشتیبانی نکند. می‌توانید این صفحه را ببندید و بعداً دستگاه را به‌صورت دستی دوباره راه‌اندازی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このOSビルドではこの手法に対応していない可能性があります。この画面を閉じ、後で手動再起動を試せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사용 중인 OS 빌드에서는 이 리스프링 방식을 지원하지 않을 수 있습니다. 이 화면을 닫고 나중에 전원 버튼을 이용해 기기를 수동으로 재시동하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка ОС может не поддерживать данный метод. Можно закрыть этот экран и позже перезагрузить устройство вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản hệ điều hành này có thể không hỗ trợ kỹ thuật trên. Bạn có thể đóng màn hình này và khởi động lại thiết bị thủ công sau."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當前系統版本可能不支持此方法。你可以關閉此頁面，稍後手動重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當前系統版本可能不支援此方法。你可以關閉此頁面，稍後手動重新啟動裝置。"
          }
        }
      }
    },
    "Your device may briefly return to the Lock Screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device may briefly return to the Lock Screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可能会短暂返回锁定屏幕。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo podría regresar brevemente a la pantalla bloqueada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است دستگاه برای لحظاتی به صفحهٔ قفل برگردد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが一時的にロック画面へ戻る場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중 기기 화면이 잠시 잠금 화면으로 돌아갈 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство может ненадолго вернуться на экран блокировки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị có thể trở về Màn hình khóa trong giây lát."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設備可能會短暫返回鎖定屏幕。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置可能會短暫返回鎖定螢幕。"
          }
        }
      }
    },
    "The cache layout or values do not match this preset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cache layout or values do not match this preset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存布局或数值与此预设不符。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estructura o los valores de la caché no coinciden con este preajuste."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساختار یا مقادیر حافظهٔ نهان با این تنظیم مطابقت ندارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュのレイアウトまたは値がこのプリセットと一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기기의 캐시 레이아웃이나 값이 선택한 프리셋의 조건과 일치하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Структура или значения кэша не соответствуют этой настройке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục hoặc giá trị bộ nhớ đệm không khớp với tùy chọn này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "快取配置或數值與此預設不符。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "快取配置或數值與此預設不符。"
          }
        }
      }
    },
    "The original value belongs to a different cache layout. A matching backup is needed to restore it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original value belongs to a different cache layout. A matching backup is needed to restore it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原值属于不同的缓存布局，需要匹配的备份才能恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor original pertenece a una estructura de caché diferente. Se necesita una copia de seguridad compatible para restaurarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار اصلی متعلق به چیدمان دیگری از حافظهٔ پنهان است. برای بازیابی آن به نسخهٔ پشتیبان سازگار نیاز است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の値は異なるキャッシュレイアウトに属しています。復元には一致するバックアップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 값이 다른 캐시 레이아웃에 속합니다. 복원하려면 일치하는 백업이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходное значение относится к другой структуре кэша. Для его восстановления нужна соответствующая резервная копия."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị gốc thuộc một bố cục bộ nhớ đệm khác. Cần có bản sao lưu phù hợp để khôi phục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "原值屬於不同的快取配置，需要相符的備份才能還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "原值屬於不同的快取配置，需要相符的備份才能還原。"
          }
        }
      }
    },
    "This preset changes unrelated cache bytes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset changes unrelated cache bytes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预设更改了无关的缓存字节。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preajuste cambia bytes de caché no relacionados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تنظیم بایت‌های نامرتبط حافظهٔ نهان را تغییر می‌دهد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットは無関係なキャッシュバイトを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프리셋은 관련 없는 시스템 캐시 바이트를 변경합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта настройка изменяет посторонние байты кэша."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn này thay đổi các byte bộ nhớ đệm không liên quan."
          }
        },
        "zh-Hant-HK": {
