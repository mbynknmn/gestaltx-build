            "value": "备份验证失败，未开始写入系统文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el respaldo. No se inició la escritura en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ پشتیبان تأیید نشد. نوشتن روی سیستم آغاز نشده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを検証できませんでした。システムへの書き込みは開始されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 파일의 무결성을 검증할 수 없어 시스템 쓰기 작업이 시작되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить резервную копию. Запись в систему не начиналась."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh bản sao lưu. Chưa bắt đầu ghi vào hệ thống."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "備份驗證失敗，未開始寫入系統文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "備份驗證失敗，未開始寫入系統檔案。"
          }
        }
      }
    },
    "This backup does not belong to this device. Open it as a local file instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup does not belong to this device. Open it as a local file instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份不属于当前设备，请将其作为本地文件打开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este respaldo no pertenece a este dispositivo. Ábrelo como archivo local."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ پشتیبان متعلق به این دستگاه نیست. آن را به‌عنوان فایل محلی باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップはこのデバイスのものではありません。代わりにローカルファイルとして開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 현재 연결된 기기의 파일이 아닙니다. 이 기기에 복원하는 대신 로컬 파일로 열어 내용을 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия принадлежит другому устройству. Откройте её как локальный файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này không thuộc thiết bị hiện tại. Hãy mở dưới dạng tệp cục bộ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份不屬於當前設備，請將其作為本地文件打開。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份不屬於當前裝置，請將其作為本地檔案開啟。"
          }
        }
      }
    },
    "MobileGestalt changed since it was loaded. Refresh before applying your edits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt changed since it was loaded. Refresh before applying your edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 已在加载后发生变化，请刷新后再应用更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt cambió desde que fue cargado. Actualiza antes de aplicar tus cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt پس از خوانده‌شدن تغییر کرده است. پیش از اعمال ویرایش‌ها دوباره آن را بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み後にMobileGestaltが変更されています。編集内容を適用する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최초 로드 시점 이후 백그라운드에서 MobileGestalt 내용이 변경되었습니다. 변경 사항을 적용하기 전에 최신 데이터를 다시 읽어 오십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt изменился после чтения. Обновите данные перед применением изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt đã thay đổi sau khi được đọc. Làm mới trước khi áp dụng chỉnh sửa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 已在加載後發生變化，請刷新後再應用更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 已在載入後發生變化，請重新整理後再應用更改。"
          }
        }
      }
    },
    "The write did not match the readback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The write did not match the readback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入内容与回读结果不一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura no coincidió con la relectura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های نوشته‌شده با نتیجهٔ بازخوانی یکسان نیستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み結果が再読み取り結果と一致しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 데이터와 다시 읽어온 값이 일치하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанные данные не совпадают с прочитанными."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung ghi không khớp với dữ liệu đọc lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入內容與回讀結果不一致。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入內容與回讀結果不一致。"
          }
        }
      }
    },
    "The original file could not be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file could not be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复原始文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar el archivo original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی فایل اصلی ممکن نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを復元できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 오류로 인해 원본 파일을 복원할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить исходный файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khôi phục tệp gốc."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復原始文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復原始檔案。"
          }
        }
      }
    },
    "Write verification and recovery failed. Keep the backup and recover the device file before trying again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write verification and recovery failed. Keep the backup and recover the device file before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入验证与恢复均失败。请保留备份，恢复设备文件后再尝试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de escritura y la recuperación fallaron. Conserva el respaldo y recupera el archivo del dispositivo antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تأیید نوشتن و بازیابی هر دو ناموفق بودند. نسخهٔ پشتیبان را نگه دارید و پیش از تلاش دوباره، فایل دستگاه را بازیابی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みの検証と復旧に失敗しました。バックアップを保管し、再試行する前にデバイスファイルを復旧してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 검증 및 원상 복구 시도가 모두 실패했습니다. 작업 중이던 백업을 안전하게 보관하고, 기기 시스템 파일을 정상 상태로 복구한 뒤 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка записи и восстановление завершились ошибкой. Сохраните резервную копию и восстановите файл устройства перед новой попыткой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh nội dung ghi và khôi phục đều thất bại. Giữ bản sao lưu và khôi phục tệp thiết bị trước khi thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入驗證與恢復均失敗。請保留備份，恢復設備文件後再嘗試。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入驗證與恢復均失敗。請保留備份，恢復裝置檔案後再嘗試。"
          }
        }
      }
    },
    "The write failed. The previous file was restored and verified.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The write failed. The previous file was restored and verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入失败，之前的文件已恢复并通过验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la escritura. El archivo anterior fue restaurado y verificado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن ناموفق بود. فایل قبلی بازیابی و تأیید شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みに失敗しました。以前のファイルを復元し、検証しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 작업에 실패했습니다. 이전 파일이 복원되고 검증되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не удалась. Предыдущий файл восстановлен и проверен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi thất bại. Tệp trước đó đã được khôi phục và xác minh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入失敗，之前的文件已恢復並通過驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入失敗，之前的檔案已恢復並透過驗證。"
          }
        }
      }
    },
    "Device access is unavailable in the Simulator. Open a plist to explore GestaltX.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device access is unavailable in the Simulator. Open a plist to explore GestaltX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器无法访问设备文件，你可以打开 plist 体验 GestaltX。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al dispositivo no está disponible en el Simulador. Abre un plist para explorar GestaltX."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به دستگاه در شبیه‌ساز ممکن نیست. برای آزمایش GestaltX یک plist باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータではデバイスにアクセスできません。plistを開いてGestaltXを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 시뮬레이터에서는 실제 기기 접근이 제한됩니다. GestaltX 인터페이스를 둘러보려면 로컬 plist를 여십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к устройству недоступен в Симуляторе. Откройте plist для знакомства с GestaltX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập thiết bị trong Trình mô phỏng. Mở tệp plist để thử GestaltX."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器無法訪問設備文件，你可以打開 plist 體驗 GestaltX。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器無法訪問裝置檔案，你可以開啟 plist 體驗 GestaltX。"
          }
        }
      }
    },
    "The signed app has no usable App Group. Enable its App Group capability and sign it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed app has no usable App Group. Enable its App Group capability and sign it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前签名没有可用的 App Group，请启用对应能力后重新签名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app firmada no tiene ningún App Group utilizable. Activa su capacidad App Group y fírmala de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ امضاشده هیچ App Group قابل استفاده‌ای ندارد. قابلیت App Group را فعال کنید و برنامه را دوباره امضا کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名済みアプリに利用可能なApp Groupがありません。App Group機能を有効にして、もう一度署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 서명 시 구성된 App Group이 유효하지 않습니다. 개발자 계정에서 App Group 기능을 활성화하고 올바르게 다시 서명하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У подписанного приложения нет доступной App Group. Включите возможность App Group и подпишите приложение заново."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã ký không có App Group khả dụng. Bật khả năng App Group và ký lại ứng dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當前簽名沒有可用的 App Group，請啓用對應能力後重新簽名。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當前簽名沒有可用的 App Group，請啟用對應能力後重新簽名。"
          }
        }
      }
    },
