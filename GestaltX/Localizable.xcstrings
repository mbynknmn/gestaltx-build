        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخی با قالب ISO 8601 وارد کنید؛ برای نمونه 2026-11-09T12:00:00Z."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2026-11-09T12:00:00ZのようなISO 8601形式の日付を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2026-11-09T12:00:00Z와 같은 ISO 8601 형식의 날짜를 입력하십시오."
          }
        },
        "ru": {
          "stringUnit": {
