    "Raw system fields. Review the key and type before saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw system fields. Review the key and type before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是原始系统字段，保存前请核对键名与类型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos sin procesar del sistema. Revisa la clave y el tipo antes de guardar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلدهای خام سیستم. پیش از ذخیره، کلید و نوع آن را بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの生データフィールドです。保存前にキーと種類を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 시스템 필드입니다. 저장하기 전에 키와 타입을 꼼꼼히 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные системные поля. Перед сохранением проверьте ключ и тип."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường hệ thống thô. Kiểm tra khóa và kiểu dữ liệu trước khi lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這裏是原始系統字段，保存前請核對鍵名與類型。"
