          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの起動画面"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 시작 이미지"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
