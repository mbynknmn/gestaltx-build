          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập gói hình nền .tendies hoặc .zip, hoặc chia sẻ gói đó đến GestaltX."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入 .tendies 或 .zip 背景圖片套件，亦可透過分享傳送至 GestaltX。"
