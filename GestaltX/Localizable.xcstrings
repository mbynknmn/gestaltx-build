    "This will attempt to restart SpringBoard using NeoSpring.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will attempt to restart SpringBoard using NeoSpring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将通过 NeoSpring 尝试重新启动 SpringBoard。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto intentará reiniciar SpringBoard mediante NeoSpring."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با استفاده از NeoSpring برای راه‌اندازی مجدد SpringBoard تلاش می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpringを使用してSpringBoardの再起動を試みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NeoSpring을 사용하여 SpringBoard 재시작을 시도합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет выполнена попытка перезапустить SpringBoard с помощью NeoSpring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ thử khởi động lại SpringBoard bằng NeoSpring."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將通過 NeoSpring 嘗試重新啓動 SpringBoard。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
