            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。"
          }
        }
      }
    },
    "Restart the device after changing the region.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device after changing the region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地区后需要重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el dispositivo después de cambiar la región."
          }
        },
        "fa": {
