          }
        }
      }
    },
    "Import this wallpaper pack? It will be added to Wallpaper Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import this wallpaper pack? It will be added to Wallpaper Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入这个壁纸包？导入后将添加到“壁纸设置”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Importar este paquete? Se añadirá a Ajustes de fondos de pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این بسته تصویر زمینه وارد شود؟ بسته به تنظیمات تصویر زمینه اضافه خواهد شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙パックをインポートしますか？「壁紙設定」に追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배경화면 팩을 가져올까요? 배경화면 설정에 추가됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировать этот набор обоев? Он появится в настройках обоев."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập gói hình nền này? Gói sẽ được thêm vào Cài đặt hình nền."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "要匯入此背景圖片套件嗎？匯入後會加入「背景圖片設定」。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要輸入此背景圖片套件嗎？輸入後會加入「背景圖片設定」。"
          }
        }
      }
    },
    "A shared file is waiting. Save or discard your current changes, then import it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared file is waiting. Save or discard your current changes, then import it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的文件等待导入，请先保存或放弃当前更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un archivo compartido pendiente. Guarda o descarta los cambios actuales y después impórtalo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک فایل اشتراک‌گذاری‌شده منتظر است. ابتدا تغییرات فعلی را ذخیره یا لغو کنید، سپس آن را وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたファイルが待機しています。現在の変更を保存するか破棄してからインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 파일이 대기 중입니다. 현재 변경 사항을 저장하거나 취소한 후 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получен файл. Сохраните или отмените текущие изменения, затем импортируйте его."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tệp chia sẻ đang chờ. Hãy lưu hoặc bỏ các thay đổi hiện tại rồi nhập tệp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的檔案等待匯入，請先儲存或放棄目前的變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的檔案等待輸入，請先儲存或放棄目前的更動。"
          }
        }
      }
    },
    "Import a .tendies or .zip wallpaper pack. You can also share it to GestaltX.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a .tendies or .zip wallpaper pack. You can also share it to GestaltX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 .tendies 或 .zip 壁纸包，也可通过分享发送到 GestaltX。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
