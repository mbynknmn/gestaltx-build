    "Display behavior depends on the panel. May increase power use and burn-in risk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display behavior depends on the panel. May increase power use and burn-in risk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示效果取决于屏幕硬件，可能增加耗电与烧屏风险。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comportamiento de la pantalla depende del panel. Puede aumentar el consumo de batería y el riesgo de retención de imagen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رفتار نمایشگر به پنل بستگی دارد. ممکن است مصرف انرژی و خطر سوختگی تصویر افزایش یابد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの動作はパネルに依存します。電力消費や焼き付きのリスクが増える可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 동작은 탑재된 패널 종류에 따라 다릅니다. 전력 소모량이 증가하고 번인 위험이 커질 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа экрана зависит от панели. Возможны повышенное энергопотребление и выгорание."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tùy thuộc vào tấm nền. Có thể tăng mức tiêu thụ điện và nguy cơ lưu ảnh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示效果取決於屏幕硬件，可能增加耗電與燒屏風險。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示效果取決於螢幕硬體，可能增加耗電與燒屏風險。"
          }
        }
      }
    },
