    "Open GestaltX to confirm importing the wallpaper pack.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open GestaltX to confirm importing the wallpaper pack."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 GestaltX 以确认导入壁纸包。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre GestaltX para confirmar la importación del paquete de fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تأیید وارد کردن بسته تصویر زمینه، GestaltX را باز کنید."
          }
        },
        "ja": {
