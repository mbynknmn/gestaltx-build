        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponer el paquete de ajustes internos de Apple. Algunos servicios del sistema pueden comportarse de manera diferente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسته تنظیمات داخلی Apple را نمایان می‌کند. برخی سرویس‌های سیستم ممکن است متفاوت رفتار کنند."
