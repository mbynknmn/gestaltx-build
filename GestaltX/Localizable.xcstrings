          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh khởi động ứng dụng"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "App 啟動畫面"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "App 啟動畫面"
          }
        }
      }
    },
    "No Launch Images": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Launch Images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无启动图"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin imágenes de inicio"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آغاز یافت نشد"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет изображений запуска"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ảnh khởi động"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有啟動畫面"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有啟動畫面"
          }
        }
      }
    },
    "Only apps with readable launch images are listed. iOS may refresh these images.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only apps with readable launch images are listed. iOS may refresh these images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示能读取启动图的 App。iOS 可能会重新生成这些图片。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran apps cuyas imágenes de inicio pueden leerse. iOS puede regenerarlas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برنامه‌هایی با تصاویر آغاز قابل خواندن نمایش داده می‌شوند. ممکن است iOS این تصاویر را بازسازی کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面を読み取れるアプリのみ表示します。iOSが画像を再生成する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지를 읽을 수 있는 앱만 표시됩니다. iOS가 이미지를 다시 생성할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны приложения с доступными изображениями запуска. iOS может пересоздать эти изображения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ liệt kê ứng dụng có ảnh khởi động đọc được. iOS có thể tạo lại các ảnh này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只列出可讀取啟動畫面的 App。iOS 可能會重新產生這些圖片。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅列出可讀取啟動畫面的 App。iOS 可能會重新產生這些圖片。"
          }
        }
      }
    },
    "Choose Photo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir foto"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب عکس"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 선택"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать фото"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇相片"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇照片"
          }
        }
      }
    },
    "Shown briefly while the app opens. Close the selected app before applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown briefly while the app opens. Close the selected app before applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 App 启动时短暂显示。应用前请先关闭目标 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra brevemente al abrir la app. Cierra la app seleccionada antes de aplicar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام باز شدن برنامه برای لحظه‌ای نمایش داده می‌شود. پیش از اعمال، برنامه انتخاب‌شده را ببندید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの起動時に短時間だけ表示されます。適用前に対象のアプリを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 열릴 때 잠깐 표시됩니다. 적용 전에 선택한 앱을 닫으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается на короткое время при запуске. Закройте выбранное приложение перед применением."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hiển thị thoáng qua khi ứng dụng mở. Đóng ứng dụng đã chọn trước khi áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只在 App 啟動時短暫顯示。套用前請先關閉目標 App。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在 App 啟動時短暫顯示。套用前請先關閉目標 App。"
          }
        }
      }
    },
    "The original launch images will be backed up before applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original launch images will be backed up before applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用前会备份原始启动图。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hará una copia de las imágenes originales antes de aplicar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از اعمال، از تصاویر آغاز اصلی نسخه پشتیبان تهیه می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用前に元の起動画面をバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용 전에 원래 시작 이미지를 백업합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед применением исходные изображения запуска будут сохранены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh khởi động gốc sẽ được sao lưu trước khi áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "套用前會備份原始啟動畫面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "套用前會備份原始啟動畫面。"
          }
        }
      }
    },
    "Only launch images changed by GestaltX will be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only launch images changed by GestaltX will be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅还原由 GestaltX 修改的启动图。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se restaurarán las imágenes modificadas por GestaltX."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط تصاویر آغاز تغییرکرده توسط GestaltX بازیابی می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltXが変更した起動画面のみ元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX가 변경한 시작 이미지만 복원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут восстановлены только изображения запуска, изменённые GestaltX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khôi phục ảnh khởi động do GestaltX thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只還原由 GestaltX 修改的啟動畫面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅還原由 GestaltX 修改的啟動畫面。"
          }
        }
      }
    },
    "Launch image saved. Close and reopen the app to see it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch image saved. Close and reopen the app to see it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动图已保存，请关闭并重新打开该 App 查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen guardada. Cierra y vuelve a abrir la app para verla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آغاز ذخیره شد. برای دیدن آن، برنامه را ببندید و دوباره باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面を保存しました。アプリを終了してから開き直すと確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지를 저장했습니다. 앱을 닫았다가 다시 열어 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение запуска сохранено. Закройте и снова откройте приложение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu ảnh khởi động. Đóng rồi mở lại ứng dụng để xem."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動畫面已儲存，請關閉並重新開啟該 App 查看。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動畫面已儲存，請關閉並重新開啟該 App 查看。"
          }
        }
      }
    },
    "Restored. Launch images refreshed by iOS were left unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored. Launch images refreshed by iOS were left unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已还原；iOS 重新生成的启动图保持不变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurado. Las imágenes regeneradas por iOS se conservaron."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی شد. تصاویر آغاز بازسازی‌شده توسط iOS بدون تغییر باقی ماندند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻しました。iOSが再生成した起動画面は変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원했습니다. iOS가 다시 생성한 시작 이미지는 유지했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлено. Изображения, пересозданные iOS, оставлены без изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục. Ảnh khởi động do iOS tạo lại được giữ nguyên."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已還原；iOS 重新產生的啟動畫面保持不變。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已還原；iOS 重新產生的啟動畫面保持不變。"
          }
        }
      }
    },
    "No launch images found. Open the app once, close it, then read again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No launch images found. Open the app once, close it, then read again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到启动图。请先打开该 App 一次，关闭后重新读取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron imágenes. Abre la app una vez, ciérrala y vuelve a leer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آغاز یافت نشد. برنامه را یک بار باز کنید، ببندید و دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面が見つかりません。対象のアプリを一度開いて終了し、再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지를 찾지 못했습니다. 앱을 한 번 열고 닫은 후 다시 읽으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения запуска не найдены. Откройте приложение один раз, закройте и прочитайте снова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy ảnh khởi động. Mở ứng dụng một lần, đóng lại rồi đọc lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到啟動畫面。請先開啟該 App 一次，關閉後重新讀取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到啟動畫面。請先開啟該 App 一次，關閉後重新讀取。"
          }
        }
      }
    },
    "The app was reinstalled. Its saved launch images cannot be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was reinstalled. Its saved launch images cannot be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 已重新安装，无法还原之前保存的启动图。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ha reinstalado. No se pueden restaurar sus imágenes anteriores."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه دوباره نصب شده است. تصاویر آغاز ذخیره‌شده آن قابل بازیابی نیستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが再インストールされています。以前に保存した起動画面は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 재설치되었습니다. 이전에 저장한 시작 이미지를 복원할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение было переустановлено. Его старые изображения запуска нельзя восстановить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã được cài lại. Không thể khôi phục ảnh khởi động đã lưu trước đó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 已重新安裝，無法還原之前儲存的啟動畫面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 已重新安裝，無法還原先前儲存的啟動畫面。"
          }
        }
      }
    },
