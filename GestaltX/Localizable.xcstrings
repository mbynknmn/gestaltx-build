    "Changes are verified. Respring when you are ready.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are verified. Respring when you are ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已验证，准备好后可执行注销。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios están verificados. Haz respring cuando estés listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات تأیید شدند. هر وقت آماده بودید ری‌اسپرینگ کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は検証済みです。準備ができたらRespringしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 검증되었습니다. 준비되면 리스프링하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения проверены. Выполните респринг, когда будете готовы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi đã được xác minh. Hãy respring khi sẵn sàng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已驗證，準備好後可執行註銷。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已驗證，準備好後可執行登出。"
          }
        }
      }
