        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX에서 가져온 팩만 삭제합니다. 적용된 배경화면은 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор будет удалён только из GestaltX. Применённые обои сохранятся."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xóa gói đã nhập khỏi GestaltX. Các hình nền đã áp dụng sẽ được giữ lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會從 GestaltX 刪除匯入套件，已套用的背景圖片會保留。"
