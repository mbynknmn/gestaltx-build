    "Connect or open a plist in Tools to browse its fields.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect or open a plist in Tools to browse its fields."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“工具”中连接设备或打开 plist，即可查看字段。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate o abre un plist en Herramientas para explorar sus campos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن فیلدها، در بخش ابزارها به دستگاه متصل شوید یا یک plist باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールで接続するかplistを開くと、フィールドを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필드를 탐색하려면 도구 메뉴에서 기기에 연결하거나 plist를 여십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к устройству или откройте plist в разделе «Инструменты», чтобы просмотреть поля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối hoặc mở tệp plist trong Công cụ để xem các trường."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在“工具”中連接設備或打開 plist，即可查看字段。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在“工具”中連線裝置或開啟 plist，即可檢視欄位。"
          }
        }
      }
