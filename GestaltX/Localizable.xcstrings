    "Enter a field key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a field key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入字段键名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa una clave de campo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید فیلد را وارد کنید."
          }
