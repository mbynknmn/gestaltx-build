    "Backups appear here before each write. You can also make one anytime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups appear here before each write. You can also make one anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次写入前会自动备份，你也可以随时手动备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los respaldos aparecen aquí antes de cada escritura. También puedes crear uno en cualquier momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از هر بار نوشتن، نسخهٔ پشتیبان در اینجا ظاهر می‌شود. هر زمان بخواهید می‌توانید نسخهٔ پشتیبان هم بسازید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各書き込みの前にバックアップがここに表示されます。いつでも作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 작업 전에 생성된 백업이 이곳에 표시됩니다. 원할 때 언제든지 백업을 수동으로 만들 수도 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии появляются здесь перед каждой записью. Их также можно создавать вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu xuất hiện ở đây trước mỗi lần ghi. Bạn cũng có thể tạo bất cứ lúc nào."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每次寫入前會自動備份，你也可以隨時手動備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每次寫入前會自動備份，你也可以隨時手動備份。"
          }
        }
      }
    },
