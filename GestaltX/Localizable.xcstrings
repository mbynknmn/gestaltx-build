            "state": "translated",
            "value": "Los valores de datos usan codificación Base64."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدارهای داده با Base64 کدگذاری می‌شوند."
          }
        },
