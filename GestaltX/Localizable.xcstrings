    "A device restart may be required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다."
          }
        },
        "ru": {
