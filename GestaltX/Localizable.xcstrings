          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取分享的 plist，請重新分享。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取分享的 plist，請重新分享。"
          }
        }
      }
    },
    "A shared plist is waiting. Save or discard your current changes, then import it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared plist is waiting. Save or discard your current changes, then import it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的 plist 等待导入，请先保存或放弃当前更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un plist compartido en espera. Guarda o descarta tus cambios actuales antes de importarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک فایل plist اشتراک‌گذاری‌شده در انتظار است. ابتدا تغییرات فعلی را ذخیره یا لغو کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有plistが待機中です。現在の変更を保存または破棄してから、読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부에서 공유된 plist 파일이 대기열에 있습니다. 현재 앱에서 작업 중이던 변경 사항을 먼저 저장하거나 취소한 후에 가져오기를 진행하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученный plist ожидает импорта. Сначала сохраните или отмените текущие изменения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có plist đã chia sẻ đang chờ nhập. Hãy lưu hoặc bỏ các thay đổi hiện tại trước."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的 plist 等待匯入，請先儲存或捨棄目前的更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的 plist 等待匯入，請先儲存或捨棄目前的更改。"
          }
        }
      }
    },
    "Save or discard your current changes before opening another plist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save or discard your current changes before opening another plist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存或放弃当前更改，再打开另一个 plist。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda o descarta tus cambios actuales antes de abrir otro plist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از باز کردن plist دیگر، تغییرات فعلی را ذخیره یا لغو کنید."
          }
        },
        "ja": {
